# Server
SERVER_PORT=8080
GIN_MODE=debug
# Serve Prometheus metrics on a separate internal port (empty disables)
METRICS_PORT=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=palimpsest
DB_PASSWORD=palimpsest
DB_NAME=palimpsest
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (release mode refuses to start unless this is a random value of 32+ characters)
JWT_SECRET=change-me-in-production

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=palimpsest
MINIO_USE_SSL=false
# Public address of the bucket, used in avatar and cover URLs
MINIO_PUBLIC_URL=http://localhost:9000/palimpsest

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=

# Google Cloud Translation v2 (optional; without it only zh-TW/zh-CN conversion works)
GOOGLE_TRANSLATE_API_KEY=

# Email for password resets (optional; without SMTP_HOST the reset link is only logged, and only in debug mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Palimpsest <no-reply@palimpsest.local>
# Public address of the web app, used in emailed links
WEB_BASE_URL=http://localhost:3000
